{
  "_meta_workflow": {"track": "z_image", "models": ["z_image_turbo_bf16.safetensors", "qwen_3_4b.safetensors", "ae.safetensors", "birefnet.safetensors"], "notes": "Z-Image-Turbo (6B), 9 étapes, cfg 1, shift 3."},
